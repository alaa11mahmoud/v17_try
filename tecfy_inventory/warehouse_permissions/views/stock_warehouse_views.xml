<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_warehouse_inherit_custom_fields" model="ir.ui.view">
            <field name="name">stock.warehouse.form.inherit.custom</field>
            <field name="model">stock.warehouse</field>
            <field name="inherit_id" ref="stock.view_warehouse"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="user_ids" widget="many2many_tags"/>
                    <field name="admin_ids" widget="many2many_tags"/>
                </xpath>
            </field>
        </record>
        
        <record id="stock.int_picking" model="ir.ui.menu">
            <field name="parent_id" ref="stock.menu_stock_root"/>
            <field name="sequence" eval="10"/>
            <field name="active" eval="True"/>
        </record>
        
        <record id="stock.menu_stock_root" model="ir.ui.menu">
            <field name="action" ref="stock.action_picking_tree_internal"/>
        </record>
        
        <record id="stock.menu_stock_warehouse_mgmt" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('stock.group_stock_manager')])]"/>
        </record>
        
        <record id="stock.stock_picking_type_menu" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('stock.group_stock_manager')])]"/>
        </record>
        
        <record id="stock.menu_stock_inventory_control" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('stock.group_stock_manager')])]"/>
        </record>
        
        <record id="tecfy_stock_report.menuitem_stock_report" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('stock.group_stock_manager')])]"/>
        </record>

        <record id="tecfy_product_import.menu_product_import" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('stock.group_stock_manager')])]"/>
        </record>
        
    </data>
</odoo>
